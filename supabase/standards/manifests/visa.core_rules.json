    {
      "ref": "10.5.1",
      "reason": "Fraud Reporting Requirements: regional sub-sections only (US, Europe, LAC); no Asia-Pacific or all-region rule. The all-region rule is 1.9.4.3."
    },
    {
      "ref": "10.15.1–10.15.4",
      "reason": "Visa Secure participation requirements. No section there states which party bears an authenticated or attempted-authentication payment; that is expressed through the Invalid Disputes list in 11.8.5."
    },
    {
      "ref": "11.8.2.5–11.8.2.6, 11.8.3.5–11.8.3.6, 11.8.4.6, 11.8.5.6",
      "reason": "Processing requirements for 10.1/10.2 and pre-arbitration (acquirer stage): outside the selection test."
