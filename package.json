    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright codegen --save-storage=tests/e2e/.auth/slice5.json http://localhost:3000/sign-in",
    "test:e2e:auth:chrome": "playwright codegen --channel=chrome --user-data-dir=tests/e2e/.auth/chrome-profile --save-storage=tests/e2e/.auth/slice5.json http://localhost:3000/sign-in",
