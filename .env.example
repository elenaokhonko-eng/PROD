# Google Gemini AI (classification, transcription, case pack generation)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=models/gemini-2.0-flash

# OpenAI (Tier-2 FIDReC helpers)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase (database + storage only, auth handled by Clerk)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CASE_PACK_BUCKET=evidence
# Shared app/worker/Edge key: at least 32 random bytes; never expose as NEXT_PUBLIC_*.
EDGE_PROXY_HMAC_SECRET=

# App
# preview | production. Leave blank to disable checkout in local development.
HARBOR_DEPLOYMENT_ENVIRONMENT=
# Server-only HTTPS Stripe success/cancel origin; must equal NEXT_PUBLIC_APP_URL.
CHECKOUT_REDIRECT_ORIGIN=
# Exact production origin. Preview checkout is rejected when it matches this value.
HARBOR_PRODUCTION_APP_ORIGIN=https://guidebuoyai.sg
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://guidebuoyai.sg
# Full deployed Git SHA. Render may supply RENDER_GIT_COMMIT instead.
RELEASE_COMMIT_SHA=

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Stripe Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SELF_SERVE_REPORT_SGD=
STRIPE_PRICE_ID_FIDREC_TIER2_PACK_SGD=
STRIPE_PRICE_ID_HUMAN_CONSULT_30M_SGD=

# Tier-1 report worker (Slice 6)
SIMULATION_KEY=
WORKER_SECRET=dev-worker-secret-change-in-production

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_MAX_RETRIES=3
SMTP_MAX_CONNECTIONS=2
SMTP_MAX_MESSAGES=50
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_FROM=info@guidebuoyai.sg
EMAIL_FROM_NAME=GuideBuoy AI
ADMIN_EMAIL=

# Logging
LOG_LEVEL=info
